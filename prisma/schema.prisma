// ============================================================================
// TRUST MART — Prisma schema (PostgreSQL)
// ============================================================================
// MONEY: every monetary column is an Int holding the amount in *minor units*
// (poisha — 1 BDT = 100 poisha). This avoids floating point drift and keeps
// values safely serialisable across the server/client boundary. Always convert
// through `src/lib/money.ts` (toMinor / fromMinor / formatMoney).
//
// DELETION: business-critical records use `deletedAt` soft deletes so historic
// orders and invoices never lose their references.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  BLOCKED
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum ProductStatus {
  /// Written but never approved — waiting for an admin to review it.
  DRAFT
  PUBLISHED
  /// Was live and has been taken down, as distinct from never reviewed.
  UNPUBLISHED
  ARCHIVED
}

enum AttributeType {
  SELECT
  COLOR
  TEXT
}

enum ShippingMode {
  STANDARD // use the district charge
  FREE // free delivery for this product
  FIXED // product-specific flat charge
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  RESERVATION
  RELEASE
  CANCELLATION
  RECEIVED
  DAMAGED
  LOST
  EXPIRED
  TRANSFER_IN
  TRANSFER_OUT
  COUNT_CORRECTION
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
  RETURNED
  REFUNDED
  FAILED
  FRAUD_REVIEW
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentMethod {
  COD
  BKASH
  SSLCOMMERZ
  MANUAL
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
}

enum DiscountType {
  FIXED
  PERCENT
}

enum PromotionScope {
  GLOBAL
  PRODUCT
  CATEGORY
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum MessageSenderRole {
  CUSTOMER
  STAFF
  SYSTEM
}

enum BannerPlacement {
  HOME_HERO
  HOME_BILLBOARD
  HOME_STRIP
  CATEGORY_TOP
  PRODUCT_SIDEBAR
  POPUP
  ANNOUNCEMENT
}

enum NotificationAudience {
  USER
  STAFF
  ALL
}

enum NavigationItemType {
  INTERNAL
  EXTERNAL
  CATEGORY
  PAGE
}

enum PageType {
  POLICY
  HELP
  GENERIC
}

/// Where an article is in the editorial pipeline. IN_REVIEW exists so a writer
/// without publish rights has somewhere to hand work off to.
enum BlogStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum HomeSectionType {
  HERO
  CATEGORY_GRID
  FEATURED_PRODUCTS
  FLASH_SALE
  TOP_SELLING
  NEW_ARRIVALS
  BANNER
  TESTIMONIALS
  TRUST_BADGES
  RICH_TEXT
}

enum ShipmentStatus {
  PENDING
  /// Parcel exists at the courier but nobody has collected it yet.
  CREATED
  PICKUP_PENDING
  PICKED
  IN_TRANSIT
  AT_HUB
  AT_DESTINATION
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  CANCELLED
  FAILED
  /// Delivery paused — customer unreachable, address wrong, weather.
  HOLD
}

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

// ============================================================================
// IDENTITY, ACCESS CONTROL & SESSIONS
// ============================================================================

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  phone            String?    @unique
  name             String
  /// Null for accounts created through Google, which have no password to check.
  passwordHash     String?
  /// Google's stable subject id, set once an account is linked.
  googleId         String?    @unique
  role             Role       @default(CUSTOMER)
  status           UserStatus @default(ACTIVE)
  avatarUrl        String?
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  staffNote        String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  addresses             Address[]
  sessions              Session[]
  orders                Order[]
  carts                 Cart[]
  reviews               Review[]
  notifications         Notification[]
  passwordResets        PasswordResetToken[]
  verificationTokens    VerificationToken[]
  permissions           UserPermission[]
  auditLogs             AuditLog[]               @relation("AuditActor")
  conversations         Conversation[]           @relation("ConversationCustomer")
  assignedConversations Conversation[]           @relation("ConversationAssignee")
  messages              Message[]
  couponRedemptions     CouponRedemption[]
  inventoryMovements    InventoryMovement[]
  orderStatusEvents     OrderStatusEvent[]
  reviewReplies         Review[]                 @relation("ReviewReplier")
  reviewReports         ReviewReport[]
  notificationPrefs     NotificationPreference[]
  createdProducts       Product[]                @relation("ProductCreator")
  tokensRaised          Token[]                  @relation("TokenAuthor")
  tokenAssignments      TokenAssignee[]          @relation("TokenAssignment")
  tokenComments         TokenComment[]           @relation("TokenComment")
  incomingStock         StockIncoming[]          @relation("IncomingCreator")
  dispatchLogs          CourierDispatchLog[]     @relation("DispatchActor")
  financeEntries        FinanceTransaction[]     @relation("FinanceCreator")
  financeAsEmployee     FinanceTransaction[]     @relation("FinanceEmployee")
  aiUsage               AiUsageLog[]             @relation("AiActor")
  aiDrafts              AiProductDraft[]         @relation("AiDraftActor")
  blogPosts             BlogPost[]               @relation("BlogAuthor")

  @@index([role, status])
  @@index([createdAt])
  @@index([phone])
  @@map("users")
}

/// Role-level permission grants. Editable by the Super Admin so operational
/// access can change without a code deploy.
model RolePermission {
  id         String  @id @default(cuid())
  role       Role
  permission String
  allowed    Boolean @default(true)

  @@unique([role, permission])
  @@index([role])
  @@map("role_permissions")
}

/// Per-user overrides layered on top of the role grants (allow or explicitly deny).
model UserPermission {
  id         String  @id @default(cuid())
  userId     String
  permission String
  allowed    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@map("user_permissions")
}

model Session {
  id         String    @id @default(cuid())
  /// SHA-256 of the opaque cookie value — the raw token is never stored.
  tokenHash  String    @unique
  userId     String
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  purpose   String    @default("EMAIL")
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model Address {
  id           String      @id @default(cuid())
  userId       String
  label        String?
  type         AddressType @default(HOME)
  fullName     String
  phone        String
  districtId   String?
  districtName String
  city         String?
  area         String?
  addressLine1 String
  addressLine2 String?
  postalCode   String?
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("addresses")
}

// ============================================================================
// CATALOG
// ============================================================================

model Category {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  parentId       String?
  description    String?
  imageUrl       String?
  bannerUrl      String?
  iconName       String?
  seoTitle       String?
  seoDescription String?
  position       Int       @default(0)
  isActive       Boolean   @default(true)
  showInMenu     Boolean   @default(true)
  isFeatured     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]       @relation("CategoryTree")
  products        Product[]
  couponTargets   CouponCategory[]
  offerTargets    OfferCategory[]
  navigationItems NavigationItem[]

  @@index([parentId])
  @@index([isActive, position])
  @@map("categories")
}

model Brand {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  logoUrl        String?
  description    String?
  seoTitle       String?
  seoDescription String?
  position       Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  products Product[]

  @@index([isActive])
  @@map("brands")
}

/// Reusable variant dimension (Size, Color, Weight, Volume, Shoe Size, …).
model Attribute {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  type      AttributeType @default(SELECT)
  unit      String?
  position  Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  options        AttributeOption[]
  products       ProductAttribute[]
  variantOptions ProductVariantOption[]

  @@map("attributes")
}

model AttributeOption {
  id          String   @id @default(cuid())
  attributeId String
  value       String
  label       String
  colorHex    String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  attribute      Attribute              @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantOptions ProductVariantOption[]

  @@unique([attributeId, value])
  @@index([attributeId, position])
  @@map("attribute_options")
}

model Product {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  sku               String?       @unique
  categoryId        String?
  brandId           String?
  shortDescription  String?
  description       String?
  specifications    Json?
  /// Base price in minor units. Variants may override it.
  price             Int           @default(0)
  compareAtPrice    Int?
  costPrice         Int?
  /// Sellable right now. Reservations are already subtracted from it.
  stock             Int           @default(0)
  /// Units promised to orders that have not left the building yet.
  stockReserved     Int           @default(0)
  /// Written off but still physically present, so it is not sellable.
  stockDamaged      Int           @default(0)
  /// Expected from suppliers; informational, never sellable.
  stockIncoming     Int           @default(0)
  lowStockThreshold Int           @default(5)
  /// Stock level at which someone should place a purchase order.
  reorderLevel      Int           @default(0)
  lastRestockedAt   DateTime?
  weightGrams       Int?
  lengthMm          Int?
  widthMm           Int?
  heightMm          Int?
  tags              String[]      @default([])
  status            ProductStatus @default(DRAFT)
  isFeatured        Boolean       @default(false)
  isTopSelling      Boolean       @default(false)
  hasVariants       Boolean       @default(false)
  manualRank        Int           @default(0)
  soldCount         Int           @default(0)
  viewCount         Int           @default(0)
  ratingAverage     Float         @default(0)
  ratingCount       Int           @default(0)
  /// Product-level shipping override (PRD update §4).
  shippingMode      ShippingMode  @default(STANDARD)
  shippingFlatFee   Int?
  seoTitle          String?
  seoDescription    String?
  canonicalUrl      String?
  ogImageUrl        String?
  noIndex           Boolean       @default(false)
  publishedAt       DateTime?
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand     Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("ProductCreator", fields: [createdById], references: [id], onDelete: SetNull)

  images             ProductImage[]
  variants           ProductVariant[]
  productAttributes  ProductAttribute[]
  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  reviews            Review[]
  flashSaleItems     FlashSaleItem[]
  couponTargets      CouponProduct[]
  couponExclusions   CouponExclusion[]
  offerTargets       OfferProduct[]
  relatedFrom        RelatedProduct[]    @relation("RelatedSource")
  relatedTo          RelatedProduct[]    @relation("RelatedTarget")
  incomingItems      StockIncomingItem[]
  aiDrafts           AiProductDraft[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([brandId])
  @@index([isFeatured, status])
  @@index([isTopSelling, status])
  @@index([soldCount])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  publicId  String?
  alt       String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

/// Which attributes a product uses for its variant matrix.
model ProductAttribute {
  id          String @id @default(cuid())
  productId   String
  attributeId String
  position    Int    @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@map("product_attributes")
}

model ProductVariant {
  id                String    @id @default(cuid())
  productId         String
  sku               String?   @unique
  /// Human readable combination label, e.g. "1kg / Black".
  name              String
  price             Int
  compareAtPrice    Int?
  costPrice         Int?
  stock             Int       @default(0)
  stockReserved     Int       @default(0)
  stockDamaged      Int       @default(0)
  stockIncoming     Int       @default(0)
  lowStockThreshold Int       @default(5)
  reorderLevel      Int       @default(0)
  lastRestockedAt   DateTime?
  barcode           String?
  weightGrams       Int?
  imageUrl          String?
  isActive          Boolean   @default(true)
  position          Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  product            Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  options            ProductVariantOption[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  flashSaleItems     FlashSaleItem[]
  incomingItems      StockIncomingItem[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductVariantOption {
  id          String @id @default(cuid())
  variantId   String
  attributeId String
  optionId    String

  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  option    AttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeId])
  @@index([optionId])
  @@map("product_variant_options")
}

model RelatedProduct {
  id        String @id @default(cuid())
  productId String
  relatedId String
  position  Int    @default(0)

  product Product @relation("RelatedSource", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelatedTarget", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId])
  @@map("related_products")
}

model InventoryMovement {
  id             String                @id @default(cuid())
  productId      String
  variantId      String?
  warehouseId    String?
  type           InventoryMovementType
  quantityChange Int
  quantityAfter  Int
  /// Cost per unit at the time of the movement, for stock valuation.
  unitCost       Int?
  reason         String?
  referenceType  String?
  referenceId    String?
  actorId        String?
  actorName      String?
  createdAt      DateTime              @default(now())

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  actor     User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@index([warehouseId, createdAt])
  @@index([type, createdAt])
  @@map("inventory_movements")
}

// ============================================================================
// CART
// ============================================================================

model Cart {
  id        String   @id @default(cuid())
  /// Opaque cookie token so guests keep a cart without an account.
  token     String   @unique
  userId    String?
  currency  String   @default("BDT")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  productId  String
  variantId  String?
  /// Empty string when there is no variant, so the unique index still applies.
  variantKey String   @default("")
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantKey])
  @@index([cartId])
  @@map("cart_items")
}

// ============================================================================
// ORDERS
// ============================================================================

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  /// Non-guessable token used for guest order tracking (PRD §41).
  publicToken   String        @unique
  userId        String?
  customerName  String
  customerEmail String?
  customerPhone String
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod @default(COD)

  // Money — all minor units, all recomputed server side at creation time.
  subtotal          Int    @default(0)
  itemDiscountTotal Int    @default(0)
  offerDiscount     Int    @default(0)
  couponDiscount    Int    @default(0)
  shippingTotal     Int    @default(0)
  taxTotal          Int    @default(0)
  grandTotal        Int    @default(0)
  paidTotal         Int    @default(0)
  refundedTotal     Int    @default(0)
  currency          String @default("BDT")

  couponId         String?
  couponCode       String?
  couponSnapshot   Json?
  /// Exact shipping calculation used at purchase time (OrderShippingSnapshot).
  shippingSnapshot Json?
  shippingAddress  Json
  billingAddress   Json?
  districtId       String?
  districtName     String?

  customerNote String?
  internalNote String?
  source       String  @default("web")
  ipAddress    String?
  userAgent    String?
  fraudScore   Int     @default(0)
  isFlagged    Boolean @default(false)
  flagReason   String?

  placedAt     DateTime  @default(now())
  confirmedAt  DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon   Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  items         OrderItem[]
  statusEvents  OrderStatusEvent[]
  payments      Payment[]
  refunds       Refund[]
  returns       ReturnRequest[]
  shipments     Shipment[]
  invoice       Invoice?
  reviews       Review[]
  redemptions   CouponRedemption[]
  conversations Conversation[]
  dispatchLogs  CourierDispatchLog[]
  transactions  FinanceTransaction[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([customerPhone])
  @@index([customerEmail])
  @@index([placedAt])
  @@index([isFlagged])
  @@map("orders")
}

/// Immutable purchase snapshot — product/variant values are copied in so later
/// catalog edits can never change historical orders or invoices.
model OrderItem {
  id                 String       @id @default(cuid())
  orderId            String
  productId          String?
  variantId          String?
  productName        String
  productSlug        String?
  variantName        String?
  sku                String?
  attributesSnapshot Json?
  imageUrl           String?
  unitPrice          Int
  compareAtPrice     Int?
  quantity           Int
  discountAmount     Int          @default(0)
  lineSubtotal       Int
  lineTotal          Int
  shippingMode       ShippingMode @default(STANDARD)
  shippingFee        Int          @default(0)
  createdAt          DateTime     @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reviews Review[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actorId    String?
  actorName  String?
  actorRole  Role?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

enum TokenCategory {
  ORDER
  PAYMENT
  PRODUCT
  CUSTOMER
  DELIVERY
  TECHNICAL
  OTHER
}

enum TokenPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TokenStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Internal ticket raised by one staff member for others to act on.
model Token {
  id          String        @id @default(cuid())
  /// Human-readable reference, e.g. TKN-000123.
  reference   String        @unique
  subject     String
  description String
  category    TokenCategory @default(OTHER)
  priority    TokenPriority @default(NORMAL)
  status      TokenStatus   @default(OPEN)

  /// Optional pointer to whatever the token is about.
  relatedType String?
  relatedId   String?

  createdById String
  resolvedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User            @relation("TokenAuthor", fields: [createdById], references: [id])
  assignees TokenAssignee[]
  comments  TokenComment[]

  @@index([status, createdAt])
  @@index([createdById])
  @@map("tokens")
}

/// Who a token is assigned to. A token may name several people.
model TokenAssignee {
  id         String    @id @default(cuid())
  tokenId    String
  userId     String
  assignedAt DateTime  @default(now())
  /// Set when this person marks their part done.
  doneAt     DateTime?

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user  User  @relation("TokenAssignment", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenId, userId])
  @@index([userId])
  @@map("token_assignees")
}

model TokenComment {
  id        String   @id @default(cuid())
  tokenId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  token  Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  author User  @relation("TokenComment", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([tokenId, createdAt])
  @@map("token_comments")
}

/// One-time codes confirming a shopper owns the mobile number on an order.
model PhoneVerification {
  id         String    @id @default(cuid())
  phone      String
  /// SHA-256 of the code. The plain code exists only in the SMS.
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  /// Set once the verification has been spent on an order.
  consumedAt DateTime?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([phone, expiresAt])
  @@map("phone_verifications")
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  provider       PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Int
  currency       String        @default("BDT")
  transactionId  String?
  /// Wallet the customer paid from, so staff can match a bKash statement line
  /// to an order without asking them for it.
  senderNumber   String?
  providerRef    String?
  /// Guarantees a webhook/callback can be retried without double-crediting.
  idempotencyKey String?       @unique
  payload        Json?
  failureReason  String?
  paidAt         DateTime?
  failedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Refund {
  id            String       @id @default(cuid())
  orderId       String
  amount        Int
  reason        String?
  status        RefundStatus @default(REQUESTED)
  requestedById String?
  approvedById  String?
  note          String?
  createdAt     DateTime     @default(now())
  processedAt   DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("refunds")
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String
  orderItemId String?
  quantity    Int          @default(1)
  reason      String
  status      ReturnStatus @default(REQUESTED)
  note        String?
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("return_requests")
}

/// Immutable invoice record. `snapshot` holds everything the PDF renders so the
/// document never changes when a product or coupon is edited afterwards.
model Invoice {
  id            String   @id @default(cuid())
  orderId       String   @unique
  invoiceNumber String   @unique
  issuedAt      DateTime @default(now())
  currency      String   @default("BDT")
  totalPayable  Int
  snapshot      Json
  generatedById String?
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  courierId      String?
  courierName    String?
  trackingNumber String?
  /// The courier's own parcel id, which is not always the tracking number.
  consignmentId  String?
  trackingUrl    String?
  status         ShipmentStatus @default(PENDING)
  note           String?
  rawStatus      Json?

  // Where the parcel is, as far as the courier has told us.
  currentLocation     String?
  deliveryManName     String?
  deliveryManPhone    String?
  estimatedDeliveryAt DateTime?
  pickupAt            DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?

  // Money. All minor units.
  /// What the courier charges us to carry this parcel.
  courierCharge    Int              @default(0)
  /// Cash the courier collected from the customer on delivery.
  collectedAmount  Int              @default(0)
  /// What the courier actually paid us, after their charge.
  settledAmount    Int              @default(0)
  settlementStatus SettlementStatus @default(PENDING)
  settledAt        DateTime?
  settlementNote   String?

  // Sync bookkeeping, so a failed webhook is visible rather than silent.
  lastSyncedAt DateTime?
  syncAttempts Int       @default(0)
  syncError    String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier      Courier?             @relation(fields: [courierId], references: [id], onDelete: SetNull)
  events       ShipmentEvent[]
  transactions FinanceTransaction[]

  @@index([orderId])
  @@index([trackingNumber])
  @@index([consignmentId])
  @@index([status, updatedAt])
  @@index([settlementStatus])
  @@map("shipments")
}

// ============================================================================
// PROMOTIONS — coupons, offers, flash sales, ads
// ============================================================================

model Coupon {
  id                String         @id @default(cuid())
  code              String         @unique
  title             String
  description       String?
  discountType      DiscountType
  /// Minor units for FIXED, basis points-free percentage (0–100) for PERCENT.
  discountValue     Int
  minOrderAmount    Int            @default(0)
  maxDiscountAmount Int?
  startAt           DateTime
  endAt             DateTime
  usageLimit        Int?
  usageCount        Int            @default(0)
  perCustomerLimit  Int?
  isActive          Boolean        @default(true)
  scope             PromotionScope @default(GLOBAL)
  allowOnFlashSale  Boolean        @default(false)
  allowStacking     Boolean        @default(false)
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  products    CouponProduct[]
  categories  CouponCategory[]
  exclusions  CouponExclusion[]
  redemptions CouponRedemption[]
  orders      Order[]

  @@index([isActive, startAt, endAt])
  @@map("coupons")
}

model CouponProduct {
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
  @@map("coupon_products")
}

model CouponCategory {
  couponId   String
  categoryId String

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
  @@map("coupon_categories")
}

model CouponExclusion {
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@map("coupon_exclusions")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  orderId   String
  userId    String?
  email     String?
  amount    Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@index([couponId, email])
  @@map("coupon_redemptions")
}

/// Time-boxed promotional offer (supports short campaigns such as a 2-hour offer).
model Offer {
  id                String         @id @default(cuid())
  title             String
  description       String?
  discountType      DiscountType
  discountValue     Int
  maxDiscountAmount Int?
  scope             PromotionScope @default(GLOBAL)
  startAt           DateTime
  endAt             DateTime
  isActive          Boolean        @default(true)
  priority          Int            @default(0)
  badgeText         String?
  showCountdown     Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  products   OfferProduct[]
  categories OfferCategory[]

  @@index([isActive, startAt, endAt])
  @@map("offers")
}

model OfferProduct {
  offerId   String
  productId String

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([offerId, productId])
  @@index([productId])
  @@map("offer_products")
}

model OfferCategory {
  offerId    String
  categoryId String

  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([offerId, categoryId])
  @@map("offer_categories")
}

model FlashSale {
  id          String   @id @default(cuid())
  title       String
  description String?
  bannerUrl   String?
  startAt     DateTime
  endAt       DateTime
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items FlashSaleItem[]

  @@index([isActive, startAt, endAt])
  @@map("flash_sales")
}

model FlashSaleItem {
  id          String  @id @default(cuid())
  flashSaleId String
  productId   String
  variantId   String?
  salePrice   Int
  stockLimit  Int?
  soldCount   Int     @default(0)
  position    Int     @default(0)

  flashSale FlashSale       @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, productId, variantId])
  @@index([productId])
  @@map("flash_sale_items")
}

model Banner {
  id                String          @id @default(cuid())
  title             String
  subtitle          String?
  placement         BannerPlacement
  imageUrl          String?
  mobileImageUrl    String?
  alt               String?
  linkUrl           String?
  ctaLabel          String?
  /// Second call to action. Both halves must be set for the button to appear —
  /// a label with no link is a button that goes nowhere.
  secondaryLinkUrl  String?
  secondaryCtaLabel String?
  htmlContent       String?
  priority          Int             @default(0)
  startAt           DateTime?
  endAt             DateTime?
  isActive          Boolean         @default(true)
  /// Popup frequency cap in hours (0 = every visit).
  frequencyHours    Int             @default(24)
  impressions       Int             @default(0)
  clicks            Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([placement, isActive, priority])
  @@map("banners")
}

// ============================================================================
// REVIEWS
// ============================================================================

model Review {
  id                 String       @id @default(cuid())
  productId          String
  userId             String?
  orderId            String?
  /// One review per purchased line item.
  orderItemId        String?      @unique
  rating             Int
  title              String?
  body               String?
  images             String[]     @default([])
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  authorName         String?
  reply              String?
  repliedById        String?
  repliedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  repliedBy User?          @relation("ReviewReplier", fields: [repliedById], references: [id], onDelete: SetNull)
  reports   ReviewReport[]

  @@index([productId, status])
  @@index([userId])
  @@index([status, createdAt])
  @@map("reviews")
}

model ReviewReport {
  id         String   @id @default(cuid())
  reviewId   String
  reporterId String?
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User?  @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([reviewId])
  @@map("review_reports")
}

// ============================================================================
// NOTIFICATIONS & MESSAGING
// ============================================================================

model Notification {
  id        String               @id @default(cuid())
  userId    String?
  audience  NotificationAudience @default(USER)
  type      String
  title     String
  body      String?
  url       String?
  meta      Json?
  isRead    Boolean              @default(false)
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([audience, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id      String  @id @default(cuid())
  userId  String
  type    String
  channel String  @default("IN_APP")
  enabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@map("notification_preferences")
}

model Conversation {
  id                String             @id @default(cuid())
  subject           String
  customerId        String?
  guestName         String?
  guestEmail        String?
  orderId           String?
  status            ConversationStatus @default(OPEN)
  priority          String             @default("NORMAL")
  assignedToId      String?
  lastMessageAt     DateTime           @default(now())
  unreadForStaff    Boolean            @default(true)
  unreadForCustomer Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  customer   User?     @relation("ConversationCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages   Message[]

  @@index([status, lastMessageAt])
  @@index([customerId])
  @@map("conversations")
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String?
  senderName     String
  senderRole     MessageSenderRole @default(CUSTOMER)
  body           String
  attachments    Json?
  isInternal     Boolean           @default(false)
  readAt         DateTime?
  createdAt      DateTime          @default(now())
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model ContactLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("NEW")
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@map("contact_leads")
}

// ============================================================================
// SHIPPING & COURIER
// ============================================================================

/// One row per Bangladesh district (64). Charge is in minor units.
model District {
  id             String   @id @default(cuid())
  name           String   @unique
  nameBn         String?
  division       String
  deliveryCharge Int      @default(12000)
  isFreeDelivery Boolean  @default(false)
  estimatedDays  String?  @default("2-4")
  isActive       Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  addresses Address[]
  orders    Order[]

  @@index([isActive, division])
  @@map("districts")
}

model Courier {
  id                  String   @id @default(cuid())
  name                String
  code                String   @unique
  description         String?
  isActive            Boolean  @default(false)
  /// Which built-in adapter drives this courier: pathao, steadfast, redx,
  /// generic (a plain REST shape) or manual (dashboard-entered tracking).
  provider            String   @default("manual")
  apiBaseUrl          String?
  trackingUrlTemplate String?
  /// Default per-parcel charge in minor units, used until the courier bills us.
  defaultCharge       Int      @default(0)
  /// Credentials live in env/secure settings; this holds non-secret config only.
  config              Json?
  position            Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shipments Shipment[]

  @@map("couriers")
}

// ============================================================================
// CMS, NAVIGATION & SETTINGS
// ============================================================================

model NavigationMenu {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items NavigationItem[]

  @@map("navigation_menus")
}

model NavigationItem {
  id           String             @id @default(cuid())
  menuId       String
  parentId     String?
  label        String
  type         NavigationItemType @default(INTERNAL)
  url          String?
  categoryId   String?
  pageId       String?
  description  String?
  imageUrl     String?
  iconName     String?
  badgeText    String?
  position     Int                @default(0)
  isActive     Boolean            @default(true)
  openInNewTab Boolean            @default(false)
  isMegaColumn Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  menu     NavigationMenu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   NavigationItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavTree")
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  page     Page?            @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([menuId, position])
  @@map("navigation_items")
}

model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String?
  content        String
  type           PageType @default(GENERIC)
  seoTitle       String?
  seoDescription String?
  noIndex        Boolean  @default(false)
  isPublished    Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  navigationItems NavigationItem[]

  @@index([type, isPublished])
  @@map("pages")
}

/// A grouping for articles. Kept separate from the product `Category` tree:
/// merging them would put "Ramadan recipes" in the shop navigation and every
/// product category in the blog filter.
model BlogCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts BlogPost[]

  @@index([isActive, position])
  @@map("blog_categories")
}

model BlogPost {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  subtitle String?
  /// Card blurb, and the fallback for the meta description when none is set.
  excerpt  String?
  /// Sanitised HTML. See `sanitizeHtml` — never render this raw from input.
  content  String

  coverImageUrl String?
  coverImageAlt String?

  categoryId String?
  tags       String[] @default([])

  status         BlogStatus @default(DRAFT)
  publishedAt    DateTime?
  /// Stored rather than computed per request, so a listing of thirty cards
  /// does not re-count thirty article bodies.
  readingMinutes Int        @default(1)
  viewCount      Int        @default(0)
  isFeatured     Boolean    @default(false)

  // SEO. Each falls back to the article's own field when left empty.
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  canonicalUrl   String?
  noIndex        Boolean @default(false)

  authorId   String?
  /// Denormalised, so removing a staff account does not blank a byline on a
  /// published article.
  authorName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?         @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  images   BlogImage[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([isFeatured, status])
  @@map("blog_posts")
}

/// Extra images for an article, beyond the cover — a gallery under the body,
/// and the pool an author picks from when placing a picture inside the content.
model BlogImage {
  id       String  @id @default(cuid())
  postId   String
  url      String
  /// Empty alt is meaningful (decorative), so this stays nullable rather than
  /// defaulting to the title and lying to a screen reader.
  alt      String?
  caption  String?
  position Int     @default(0)

  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
  @@map("blog_images")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General")
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, category, position])
  @@map("faqs")
}

model HomeSection {
  id        String          @id @default(cuid())
  key       String          @unique
  type      HomeSectionType
  title     String?
  subtitle  String?
  config    Json?
  position  Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([isActive, position])
  @@map("home_sections")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  avatarUrl String?
  rating    Int      @default(5)
  body      String
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("testimonials")
}

/// Generic key/value configuration store powering the no-code dashboard.
/// `group` buckets keys (site, seo, analytics, payment, shipping, feature, ai…).
model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  group       String   @default("general")
  value       Json
  label       String?
  description String?
  /// Secret values are never returned to the browser.
  isSecret    Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([group])
  @@map("settings")
}

// ============================================================================
// AUDIT, SECURITY & IDEMPOTENCY
// ============================================================================

model AuditLog {
  id         String        @id @default(cuid())
  actorId    String?
  actorName  String?
  actorRole  Role?
  action     String
  entityType String?
  entityId   String?
  summary    String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  severity   AuditSeverity @default(INFO)
  createdAt  DateTime      @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

/// Durable rate-limit counters (works across serverless instances).
model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("rate_limits")
}

/// Records processed webhook/callback ids so retries stay idempotent.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  payload     Json?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Inventory — warehouses, incoming stock and the adjustment ledger
// ---------------------------------------------------------------------------

/**
 * A physical place stock sits in.
 * Per-warehouse balances are not stored as counters. They are derived by
 * summing the movement ledger for that warehouse, which cannot drift out of
 * sync with the movements the way a duplicated counter can. The product-level
 * counters stay the fast path for "can I sell this right now".
 */
model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  phone     String?
  /// Where stock lands when an adjustment does not name a warehouse.
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements InventoryMovement[]
  incoming  StockIncoming[]

  @@index([isActive, position])
  @@map("warehouses")
}

enum IncomingStockStatus {
  DRAFT
  EXPECTED
  PARTIAL
  RECEIVED
  CANCELLED
}

/// A shipment of stock on its way in from a supplier.
model StockIncoming {
  id            String              @id @default(cuid())
  reference     String              @unique
  supplierName  String
  supplierPhone String?
  warehouseId   String?
  status        IncomingStockStatus @default(EXPECTED)
  expectedAt    DateTime?
  receivedAt    DateTime?
  /// Freight, duty and handling, in minor units — folded into the stock value.
  shippingCost  Int                 @default(0)
  note          String?
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  warehouse Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  createdBy User?               @relation("IncomingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     StockIncomingItem[]

  @@index([status, expectedAt])
  @@map("stock_incoming")
}

model StockIncomingItem {
  id               String  @id @default(cuid())
  incomingId       String
  productId        String
  variantId        String?
  quantity         Int
  receivedQuantity Int     @default(0)
  /// Cost per unit in minor units, used to value the stock received.
  unitCost         Int     @default(0)

  incoming StockIncoming   @relation(fields: [incomingId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([incomingId])
  @@index([productId])
  @@map("stock_incoming_items")
}

// ---------------------------------------------------------------------------
// Courier — shipment tracking, dispatch attempts and settlement
// ---------------------------------------------------------------------------

enum SettlementStatus {
  PENDING
  PARTIAL
  RECEIVED
  DISPUTED
}

/// One reported step in a parcel's journey, however it reached us.
model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  /// Courier's own wording, kept verbatim so support can quote it back.
  description String?
  location    String?
  occurredAt  DateTime       @default(now())
  /// "webhook", "poll" or "manual" — how we learnt about this step.
  source      String         @default("webhook")
  raw         Json?
  createdAt   DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

/// A record of every attempt to hand a parcel to a courier, successful or not.
model CourierDispatchLog {
  id           String   @id @default(cuid())
  orderId      String
  shipmentId   String?
  courierCode  String
  /// "create", "cancel", "sync" — which call this was.
  operation    String
  success      Boolean
  statusCode   Int?
  /// Request/response with credentials stripped before storing.
  request      Json?
  response     Json?
  errorMessage String?
  actorId      String?
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation("DispatchActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([success, createdAt])
  @@map("courier_dispatch_logs")
}

// ---------------------------------------------------------------------------
// Accounts & finance
// ---------------------------------------------------------------------------

enum FinanceAccountType {
  CASH
  BANK
  MOBILE_WALLET
  COURIER_RECEIVABLE
  OTHER
}

enum TransactionKind {
  INCOME
  EXPENSE
  TRANSFER
}

/// Where money sits: the till, a bank account, a bKash wallet, courier float.
model FinanceAccount {
  id             String             @id @default(cuid())
  name           String
  code           String             @unique
  type           FinanceAccountType @default(CASH)
  /// Balance before Trust Mart started keeping books here, in minor units.
  openingBalance Int                @default(0)
  accountNumber  String?
  isActive       Boolean            @default(true)
  position       Int                @default(0)
  note           String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  transactions FinanceTransaction[]

  @@index([isActive, position])
  @@map("finance_accounts")
}

/// A bucket to file money under. Seeded with the categories the shop needs.
model ExpenseCategory {
  id       String          @id @default(cuid())
  name     String
  slug     String          @unique
  kind     TransactionKind @default(EXPENSE)
  /// System categories are wired to automatic postings and cannot be deleted.
  isSystem Boolean         @default(false)
  isActive Boolean         @default(true)
  position Int             @default(0)

  transactions FinanceTransaction[]

  @@index([kind, position])
  @@map("expense_categories")
}

/**
 * A single money movement.
 * Financial rows are never hard-deleted. Correcting one voids it and leaves
 * both the original and the reason in place, and every edit writes a revision,
 * so the books can always be replayed.
 */
model FinanceTransaction {
  id            String          @id @default(cuid())
  reference     String          @unique
  kind          TransactionKind
  categoryId    String?
  accountId     String?
  /// Positive minor units. `kind` carries the direction, not the sign.
  amount        Int
  occurredAt    DateTime        @default(now())
  description   String
  paymentMethod String?
  vendorName    String?
  employeeId    String?
  orderId       String?
  shipmentId    String?
  attachmentUrl String?
  note          String?
  /// True for rows the system posted itself (a sale, a courier settlement).
  isAutomatic   Boolean         @default(false)
  createdById   String?
  updatedById   String?
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  category  ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account   FinanceAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  employee  User?            @relation("FinanceEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shipment  Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("FinanceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  revisions FinanceTransactionRevision[]

  @@index([kind, occurredAt])
  @@index([categoryId, occurredAt])
  @@index([orderId])
  @@index([occurredAt])
  @@index([voidedAt])
  @@map("finance_transactions")
}

model FinanceTransactionRevision {
  id            String   @id @default(cuid())
  transactionId String
  actorId       String?
  actorName     String?
  /// "create", "update", "void".
  action        String
  before        Json?
  after         Json?
  createdAt     DateTime @default(now())

  transaction FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, createdAt])
  @@map("finance_transaction_revisions")
}

// ---------------------------------------------------------------------------
// AI automation
// ---------------------------------------------------------------------------

enum AiDraftStatus {
  PENDING
  RUNNING
  READY
  FAILED
  APPLIED
  DISCARDED
}

/// What an AI call cost and whether it worked. Never stores the API key.
model AiUsageLog {
  id           String   @id @default(cuid())
  provider     String
  model        String
  /// "product_draft", "assistant", "seo" — which feature spent the tokens.
  feature      String
  promptTokens Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  success      Boolean  @default(true)
  errorMessage String?
  actorId      String?
  createdAt    DateTime @default(now())

  actor User? @relation("AiActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([feature, createdAt])
  @@index([provider, createdAt])
  @@map("ai_usage_logs")
}

/**
 * A product the AI has proposed but nobody has approved yet.
 * Drafts never become products on their own. A staff member reads the payload,
 * edits anything they disagree with, and presses publish — the automation
 * setting that skips that step is off unless the owner turns it on.
 */
model AiProductDraft {
  id           String        @id @default(cuid())
  prompt       String
  status       AiDraftStatus @default(PENDING)
  provider     String?
  model        String?
  /// The generated fields, shaped like the product form.
  payload      Json?
  errorMessage String?
  productId    String?
  actorId      String?
  appliedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  actor   User?    @relation("AiDraftActor", fields: [actorId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("ai_product_drafts")
}
